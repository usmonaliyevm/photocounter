# @BotFather dan olingan token
BOT_TOKEN=123456789:AAAA-your-token-here

# Hisobotlarni shaxsiy chatda oladigan adminlar (Telegram ID, vergul bilan).
# Botni guruhga qo'shgan odam va guruh adminlari ham avtomatik ruxsat oladi.
ADMIN_IDS=

# Har bir agent uchun haftalik plan (dona). Keyin /plan buyrug'i bilan o'zgartirish mumkin.
DEFAULT_WEEKLY_PLAN=100

# Har kuni shu vaqtda bot guruhga kunlik hisobot yuboradi (yakshanba kuni haftalik ham). Bo'sh qoldirsangiz o'chadi.
REPORT_TIME=21:00

# Vaqt zonasi
TIMEZONE=Asia/Tashkent

# Guruhda bot jim turadi. Sanalgan rasmga reaksiya qo'yishini xohlasangiz emoji yozing (masalan 👍).
REACT_EMOJI=
# Takror rasm tashlanganda adminlarga darhol shaxsiy xabar (1 = ha, 0 = yo'q)
DUP_NOTIFY=1

# Takror rasmni aniqlash: farq chegarasi (bit, 256 dan; 20 = qayta yuklangan nusxa ham ushlanadi)
DUP_THRESHOLD=20
# Takrorni oxirgi necha kundagi rasmlar bilan solishtirish
DUP_DAYS=90

# Eski tarixni import qilish uchun (import_history.py): https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=

# SQLite baza fayli
DB_PATH=data.db
